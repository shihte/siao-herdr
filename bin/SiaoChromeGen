#!/usr/bin/env python3
# SiaoChromeGen <app home>: mods/SiaoChrome = Herdr's own workspace-chrome (logo, search, sidebar
# toggle, Settings) renamed SiaoDesk, in Chinese and without its own background, so it sits inside the
# layout's cards. Made from the installed copy at every install, so it follows Herdr's updates.
import os, sys
Home = sys.argv[1]
Src = open(f"{Home}/mods/workspace-chrome/main.js").read()
Edits = [
    ('child("Herdr")', 'child("SiaoDesk")'),
    ('"Settings"', '"設定"'),
    ('"Add machine"', '"新增機器"'),
    ("return v_flex().size_full().bg(t.chrome)", "return h_flex().size_full().gap(4).items_center().bg(t.chrome)"),
    (".bg(t.chrome).border_t(1).border_color(t.border).px(8).pt(4).pb(8)", ".px(8)"),
    ("h_flex().size_full().bg(t.chrome).pl(", "h_flex().size_full().pl("),
    ("export default class WorkspaceChrome", "export default class SiaoChrome"),
]
Out = Src
for Old, New in Edits:
    if Old not in Out: print(f"SiaoChrome: Herdr changed workspace-chrome, skipped: {Old}", file=sys.stderr)
    Out = Out.replace(Old, New)
D = f"{Home}/mods/SiaoChrome"; os.makedirs(D, exist_ok=True)
open(f"{D}/main.js", "w").write("// Generated by SiaoChromeGen from mods/workspace-chrome — do not edit.\n" + Out)
open(f"{D}/mod.json", "w").write('{ "place": "none" }\n')
